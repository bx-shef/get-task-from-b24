{
  "name": "get-task-from-b24",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nitro dev",
    "build": "nitro build && pnpm build:ops",
    "preview": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build:ops": "esbuild src/ops/exportIssues.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=.output/server/ops-issues.mjs"
  },
  "dependencies": {
    "@bitrix24/b24jssdk": "^2.2.0",
    "bullmq": "^6.2.2",
    "ioredis": "^6.0.0",
    "nitropack": "^2.13.4",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "h3": "1.15.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
