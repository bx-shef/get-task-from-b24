# Обработчик событий Битрикс24 → задачи в наш Б24.
# Копия: cp .env.example .env — и заполнить. Реальные значения в репозиторий не попадают.

# --- Наш обработчик ---------------------------------------------------------
# Публичный HTTPS-адрес сервиса: его же указывают в форме локального приложения
# на портале клиента (docs/CLIENT_APP.md).
PUBLIC_BASE_URL=https://get-task-from-b24.bx-shef.by

# --- Порталы клиентов -------------------------------------------------------
# Список поддерживаемых Б24 (планируется 20–30). Одной переменной с JSON-массивом:
#   domain        — домен портала клиента
#   responsibleId — id «особого» ответственного НА ПОРТАЛЕ КЛИЕНТА; задачи с другим
#                   исполнителем не переносятся (docs/PROCESSING.md → «Критерии отбора»)
#   clientId/clientSecret — ключи локального приложения, выданные формой Б24
#
# ⚠ Портала нет в списке — событие отбрасывается, даже если подписка жива.
# ⚠ Живые OAuth-токены сюда НЕ кладутся: они продлеваются в рантайме, а окружение
#   не меняется. Место их хранения — открытый вопрос (docs/CLIENT_APP.md).
B24_PORTALS=[{"domain":"client-one.bitrix24.ru","responsibleId":17,"clientId":"local.xxxxxxxx","clientSecret":"xxxxxxxx"}]

# --- Наш Битрикс24 (приёмник) ----------------------------------------------
# Входящий вебхук с правом task. ⚠ Секрет: в логи не попадает.
B24_TARGET_WEBHOOK_URL=https://my.bitrix24.ru/rest/1/xxxxxxxxxxxx/

# --- Критерий отбора --------------------------------------------------------
# Префикс названия задачи (сравнение без учёта регистра; в задаче у нас срезается).
TASK_TITLE_PREFIX=#support

# --- Как создаём задачу у себя ----------------------------------------------
# Исполнитель ВСЕХ переносимых задач — id сотрудника НАШЕГО портала.
B24_TARGET_RESPONSIBLE_ID=1
# Срок, если у задачи клиента его нет: часов от момента создания.
DEFAULT_DEADLINE_HOURS=24

# --- Telegram ---------------------------------------------------------------
# Сообщение «задача создана — иди делай» после успешного переноса; туда же уходят
# ошибки переноса (с указанием портала и ID задачи у клиента).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Очередь и хранилище ----------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Ключ шифрования OAuth-токенов портала в базе: openssl rand -hex 32
B24_TOKEN_ENC_KEY=
